      "options": [
        { "label": "CÓ — bán!", "next": "gac_dac_sold" },
        { "label": "KHÔNG", "next": null }
      ]
    },
    "gac_dac_sold": {
      "text": "Xu đã vào túi! Mai lại ghé, ta để hàng tốt cho ngươi. He he!",
